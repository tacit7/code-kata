{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Code Kata Python",
  "version": "1.0.1",
  "identifier": "com.code-kata.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Code Kata Python",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../.codex/skills/kata-student-helper/SKILL.md": "agent/skills/kata-student-helper/SKILL.md",
      "../tools/kata-agent.mjs": "agent/kata-agent.mjs",
      "../docs/agent_bridge.md": "agent/agent_bridge.md"
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
